<Window x:Class="Containers.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Containers"
        mc:Ignorable="d"
        Title="Заказ блюда на вывоз" Height="450" Width="800"
        MinHeight="350"
        MinWidth="400"
        
        >
    <Grid Background="WhiteSmoke">

        <DockPanel LastChildFill="True"> 
            <!--DockPanel позволяет поместить TextBlock'и в нижнем и верхнем краях окна, а сам Grid по-середине, заполняя все оставшееся место собой-->
            <TextBlock DockPanel.Dock="Bottom" FontSize="18" Background="SaddleBrown" Foreground="White" Text="Заказ блюда с самовывозом" Padding="10"/>
            <TextBlock DockPanel.Dock="Bottom" FontSize="12" Background="LightGray" Foreground="LightSlateGray" Text="Заказ № 128 Готовность: 18:30" Padding="5"/>
            <Grid Margin="10,10,10,10" DockPanel.Dock="Top" Background="White" Width="auto" Height="auto">
                <!--Grid нужен для того, чтобы разместить каждый элемент в свои столбик и колонку, тем самым создавая порядок-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    
                    
                </Grid.RowDefinitions>

                <!--Первый столбик-->
                <Label Content="Состав заказа" FontSize="14" FontWeight="Bold" />

                <Label Content="Блюдо" FontSize="12" Grid.Row="1"/>

                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical">
                    <ComboBox SelectedIndex="0"  FontSize="12" Grid.Row="1" Grid.Column="1"  Width="auto" Height="20">
                        <ComboBoxItem Content="Паста с грибами"/>
                        <ComboBoxItem Content="Борщ"/>
                        <ComboBoxItem Content="Блины"/>
                    </ComboBox>
                </StackPanel>

                <Label Content="Размер порции" FontSize="12" Grid.Row="2"/>

                <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Vertical">
                    <ComboBox Grid.Column="1" SelectedIndex="0"   FontSize="12" Grid.Row="2"  Width="auto" Height="20">
                        <ComboBoxItem Content="Маленькая"/>
                        <ComboBoxItem Content="Средняя"/>
                        <ComboBoxItem Content="Большая"/>
                    </ComboBox>
                </StackPanel>

                <Label Content="Количество" FontSize="12" Grid.Row="3"/>

                <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Vertical">
                    <ComboBox Grid.Column="1" SelectedIndex="0" FontSize="12" Grid.Row="3"  Width="auto" Height="20">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                    </ComboBox>
                </StackPanel>

                <Label Content="Напиток" FontSize="12" Grid.Row="4"/>
                <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Vertical">
                    <ComboBox Grid.Column="1" SelectedIndex="0"  FontSize="12" Grid.Row="4"  Width="auto" Height="20">
                        <ComboBoxItem Content="Вода"/>
                        <ComboBoxItem Content="Чай"/>
                        <ComboBoxItem Content="Кофе"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.ColumnSpan="2" Orientation="Vertical" Grid.Row="5">
                    <!--Здесь использован StackPanel, чтобы растянуть TextBox до конца его клетки-->
                    <Label Content="Комментарий к приготовлению" FontSize="12" Grid.Row="5"/>
                    <TextBox Width="auto" FontSize="12" Height="60"/>
                </StackPanel>
                <WrapPanel Grid.ColumnSpan="2" Orientation="Vertical" Grid.Row="6">
                    <!--Две wrappanel нужны, чтобы "Добавки" и вторая WrapPanel друг под другом, когда содержимое второй WrapPanel находится в горизонтальном положении. Они будут переходить на следующую строку при нехватке места.-->
                    <Label Content="Добавки" FontSize="14" FontWeight="Bold"/>
                    <WrapPanel >    
                        <CheckBox Margin="0,0,5,0"  Content="Сыр"/>
                        <CheckBox Margin="0,0,5,0" Content="Грибы"/>
                        <CheckBox Margin="0,0,5,0" Content="Томаты"/>
                        <CheckBox Margin="0,0,5,0" Content="Зелень"/>
                        <CheckBox Margin="0,0,5,0" Content="Острый соус"/>
                        <CheckBox Margin="0,0,5,0" Content="Чесночный соус"/>
                    </WrapPanel>
                </WrapPanel>




                <!--Второй столбик-->
                <Label Content="Контактные данные" FontSize="14" FontWeight="Bold" Grid.Column="2"/>

                <Label Grid.Column="2" Content="Имя клиента" FontSize="12" Grid.Row="1"/>
                <StackPanel Grid.Column="3" Grid.Row="1" Orientation="Vertical">
                    <TextBox   FontSize="12"   Width="auto" Height="20" VerticalAlignment="Center" />
                </StackPanel>

                <Label Grid.Column="2" Content="Телефон" FontSize="12" Grid.Row="2"/>

                <StackPanel Grid.Column="3" Grid.Row="2" Orientation="Vertical">
                    <TextBox   FontSize="12"  Width="auto" Height="20" />
                </StackPanel>
                
                <Label Grid.Column="2" Content="Время получения" FontSize="12" Grid.Row="3"/>

                <StackPanel Grid.Column="3" Grid.Row="3" Orientation="Vertical">
                    <ComboBox Grid.Column="3" SelectedIndex="0"  FontSize="12" Grid.Row="3"  Width="auto" Height="20">
                    <ComboBoxItem Content="18:30"/>
                    <ComboBoxItem Content="19:30"/>
                    <ComboBoxItem Content="20:30"/>
                </ComboBox>
                </StackPanel>

                <Label Grid.Column="2" Content="Способ оплаты" FontSize="12" Grid.Row="4"/>
                
                <StackPanel Grid.Column="3" Grid.Row="4" Orientation="Vertical">
                <ComboBox SelectedIndex="0" Grid.Column="3"  FontSize="12" Grid.Row="4"  Width="auto" Height="20">
                    <ComboBoxItem Content="Банковская карта"/>
                    <ComboBoxItem Content="Наличные"/>
                    <ComboBoxItem Content="СБП"/>
                </ComboBox>
                </StackPanel>

                <StackPanel Grid.RowSpan="2" Grid.Row="5" Grid.ColumnSpan="2" Grid.Column="2">
                    <!--StackPanel позволяет организовать элементы друг под другом, заняв при этом пару строк, а также растянув кнопки на всю ширину их колонок -->
                    <Label Content="Блюда: 650 ₽"/>
                    <Label Content="Напитки: 150 ₽"/>
                    <Label Content="Итого: 800 ₽"/>

                    <CheckBox Margin="0,10,0,0" Content="Нужны столовые приборы"/>
                    <Button Margin="0,5,0,0" Height="25" Content="Оформить"/>
                    <Button Margin="0,5,0,0" Height="25" Content="Отмена"/>
                </StackPanel>
            </Grid>

            
            
        </DockPanel>

    </Grid>
</Window>
